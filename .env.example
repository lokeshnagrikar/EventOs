# ==============================================================================
# EventOS Master Environment Template (.env.example)
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eventos_root
POSTGRES_USER=<YOUR_POSTGRES_USER>
POSTGRES_PASSWORD=<YOUR_STRONG_POSTGRES_PASSWORD>

# ------------------------------------------------------------------------------
# 2. Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=<YOUR_RABBITMQ_USER>
RABBITMQ_PASS=<YOUR_STRONG_RABBITMQ_PASSWORD>

# ------------------------------------------------------------------------------
# 4. JWT & Gateway Trust Security
# ------------------------------------------------------------------------------
# JWT Secret (Min 64 hex characters or 256-bit secret)
JWT_SECRET_KEY=<YOUR_SECURE_JWT_SECRET_KEY_MIN_64_CHARS>
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Optional RSA-256 Public/Private PEM (Base64 encoded or path)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Internal shared secret between API Gateway and downstream microservices
GATEWAY_TRUST_SECRET=<YOUR_UNIQUE_GATEWAY_SHARED_SECRET_KEY>

# PII Encryption Key for Database Fields (AES-256: exactly 32 alphanumeric bytes)
ENCRYPTION_KEY=<YOUR_32_CHAR_PII_AES256_ENCRYPTION_KEY>

# Initial SuperAdmin Bootstrap Secret
BOOTSTRAP_SECRET=<YOUR_SECURE_BOOTSTRAP_SECRET>

# ------------------------------------------------------------------------------
# 5. Domain, CORS & Cookie Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=https://eventosapp.in
CORS_ALLOWED_ORIGINS=https://eventosapp.in,https://www.eventosapp.in
COOKIE_DOMAIN=eventosapp.in
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# ------------------------------------------------------------------------------
# 6. Email / SMTP Configuration (e.g., Resend, Sendgrid, AWS SES)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=<YOUR_SMTP_API_PASSWORD>
APP_MAIL_FROM=support@eventosapp.in
FOUNDER_ALERT_EMAIL=<YOUR_FOUNDER_EMAIL>

# ------------------------------------------------------------------------------
# 7. Third-Party Integrations
# ------------------------------------------------------------------------------
# Cloudinary (Media assets & client galleries)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=<YOUR_RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<YOUR_RAZORPAY_WEBHOOK_SECRET>

# Stripe Payment Gateway (Optional / Alternative)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth & ReCAPTCHA
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=<YOUR_RECAPTCHA_SECRET_KEY>

# ------------------------------------------------------------------------------
# 8. Frontend Public Environment Variables (Build ARGs / Client-side)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.eventosapp.in/api/v1
NEXT_PUBLIC_APP_URL=https://eventosapp.in
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<YOUR_RECAPTCHA_SITE_KEY>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
NEXT_PUBLIC_RAZORPAY_KEY_ID=<YOUR_RAZORPAY_KEY_ID>