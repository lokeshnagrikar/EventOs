# ==========================================
# EventOS Frontend - Environment Variables Template
# ==========================================

# The base URL of the API Gateway that routes to the microservices.
# Locally: http://localhost:8080/api/v1
# Production: https://api.eventosapp.in/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Primary Public Domain for Share Links (Galleries, Quotes, Client Portals)
NEXT_PUBLIC_APP_URL=https://eventosapp.in

# Google reCAPTCHA v2 Checkbox site key (Obtain from Google reCAPTCHA Admin Console)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<YOUR_RECAPTCHA_SITE_KEY>

# Google OAuth Client ID (Obtain from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# Razorpay Public Key ID (Obtain from Razorpay Dashboard: rzp_test_... or rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=<YOUR_RAZORPAY_KEY_ID>

# Internal Docker Network API URL (Used during server-side container requests)
INTERNAL_API_URL=http://api-gateway:8080/api/v1
